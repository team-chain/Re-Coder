# ReCoder default .dockerignore — 이미지 크기/빌드 시간 단축용
.git
.gitignore
.github/
.vscode/
.idea/
README.md
*.md
.DS_Store
Thumbs.db

# OS / IDE
__pycache__/
*.py[cod]
*$py.class

# Local secrets — 절대 이미지에 포함 금지
.env
.env.*
!.env.example

# 빌드 산출물
dist/
build/
out/
.next/
.cache/
coverage/
*.log

# Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
