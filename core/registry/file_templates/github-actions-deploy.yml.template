# ==============================================================================
# ReCoder File Template: github-actions-deploy.yml.template
# Production CI/CD workflow: build → push to ECR → deploy via SSH
# Placeholders: {{APP_NAME}}, {{AWS_REGION}}, {{AWS_ACCOUNT_ID}},
#               {{ECR_REPO}}, {{CONTAINER_NAME}}, {{PORT}},
#               {{CONTAINER_PORT}}, {{HEALTH_CHECK_PATH}},
#               {{BRANCH}}, {{DOCKERFILE_PATH}}
# ==============================================================================

name: Deploy {{APP_NAME}}

on:
  push:
    branches:
      - {{BRANCH}}
  workflow_dispatch:

env:
  AWS_REGION: {{AWS_REGION}}
  ECR_REGISTRY: {{AWS_ACCOUNT_ID}}.dkr.ecr.{{AWS_REGION}}.amazonaws.com
  ECR_REPOSITORY: {{ECR_REPO}}
  CONTAINER_NAME: {{CONTAINER_NAME}}
  IMAGE_TAG: ${{ github.sha }}

jobs:
  # --------------------------------------------------------------------------
  # Job 1: Run tests
  # --------------------------------------------------------------------------
  test:
    name: Run Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up environment
        run: echo "Add your test setup steps here"

      - name: Run tests
        run: echo "Add your test command here (e.g. pytest, npm test)"

  # --------------------------------------------------------------------------
  # Job 2: Build and push Docker image to ECR
  # --------------------------------------------------------------------------
  build-and-push:
    name: Build & Push to ECR
    runs-on: ubuntu-latest
    needs: test
    outputs:
      image: ${{ steps.build-image.outputs.image }}

    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/github-actions-deploy
          aws-region: ${{ env.AWS_REGION }}

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build, tag, and push image
        id: build-image
        run: |
          IMAGE_URI="${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:${{ env.IMAGE_TAG }}"
          docker build \
            -t "$IMAGE_URI" \
            -f {{DOCKERFILE_PATH}} \
            --label "git.commit=${{ github.sha }}" \
            --label "git.branch=${{ github.ref_name }}" \
            --cache-from "${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:latest" \
            .
          docker push "$IMAGE_URI"
          # Also tag as latest
          docker tag "$IMAGE_URI" "${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:latest"
          docker push "${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:latest"
          echo "image=$IMAGE_URI" >> "$GITHUB_OUTPUT"

  # --------------------------------------------------------------------------
  # Job 3: Deploy to server via SSH
  # --------------------------------------------------------------------------
  deploy:
    name: Deploy to Server
    runs-on: ubuntu-latest
    needs: build-and-push
    environment: production

    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          script: |
            set -euo pipefail

            IMAGE="${{ needs.build-and-push.outputs.image }}"
            CONTAINER="${{ env.CONTAINER_NAME }}"
            REGION="${{ env.AWS_REGION }}"
            REGISTRY="${{ env.ECR_REGISTRY }}"

            echo "==> Logging in to ECR"
            aws ecr get-login-password --region "$REGION" \
              | docker login --username AWS --password-stdin "$REGISTRY"

            echo "==> Pulling new image: $IMAGE"
            docker pull "$IMAGE"

            echo "==> Stopping old container (if running)"
            docker stop "$CONTAINER" 2>/dev/null || true
            docker rm "$CONTAINER" 2>/dev/null || true

            echo "==> Starting new container"
            docker run -d \
              --name "$CONTAINER" \
              -p {{PORT}}:{{CONTAINER_PORT}} \
              --env-file /opt/{{APP_NAME}}/.env \
              --restart unless-stopped \
              --log-driver json-file \
              --log-opt max-size=50m \
              --log-opt max-file=5 \
              "$IMAGE"

            echo "==> Waiting for health check"
            sleep 10
            HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
              http://localhost:{{PORT}}{{HEALTH_CHECK_PATH}} || echo "000")

            if [ "$HTTP_STATUS" != "200" ]; then
              echo "ERROR: Health check failed (HTTP $HTTP_STATUS). Rolling back..."
              docker stop "$CONTAINER" && docker rm "$CONTAINER"
              PREV_IMAGE=$(docker images "$REGISTRY/$ECR_REPOSITORY" \
                --format "{{.Repository}}:{{.Tag}}" | sed -n '2p')
              if [ -n "$PREV_IMAGE" ]; then
                docker run -d \
                  --name "$CONTAINER" \
                  -p {{PORT}}:{{CONTAINER_PORT}} \
                  --env-file /opt/{{APP_NAME}}/.env \
                  --restart unless-stopped \
                  "$PREV_IMAGE"
                echo "Rolled back to $PREV_IMAGE"
              fi
              exit 1
            fi

            echo "==> Deployment successful (HTTP $HTTP_STATUS)"

            echo "==> Cleaning up old images"
            docker image prune -f
