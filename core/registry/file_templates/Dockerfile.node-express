# ==============================================================================
# ReCoder File Template: Dockerfile.node-express
# Production-grade Dockerfile for Node.js / Express applications
# Placeholders: {{APP_NAME}}, {{NODE_VERSION}}, {{PORT}}, {{START_SCRIPT}},
#               {{HEALTH_CHECK_PATH}}
# ==============================================================================

# ---- Dependency installation stage ----
FROM node:{{NODE_VERSION}}-alpine AS deps

WORKDIR /app

# Copy package manifests
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

# Install production dependencies only
# pnpm 버전은 프로젝트 lock 파일을 따른다(고정하지 않음).
# hadolint ignore=DL3016
RUN if [ -f yarn.lock ]; then \
        yarn install --frozen-lockfile --production; \
    elif [ -f pnpm-lock.yaml ]; then \
        npm install -g pnpm && pnpm install --frozen-lockfile --prod; \
    elif [ -f package-lock.json ]; then \
        npm ci --omit=dev; \
    else \
        npm install --omit=dev; \
    fi
# 의존성이 없는 package.json(스크립트만 있는 모노레포 루트 등)이면 npm 이 node_modules 를 만들지 않는다 —
# 실행 단계의 COPY 가 "not found" 로 빌드를 깨뜨리지 않게 폴더를 둔다.
RUN mkdir -p node_modules

# ---- Build stage (for TypeScript / transpiled projects) ----
FROM node:{{NODE_VERSION}}-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

# pnpm 버전은 프로젝트 lock 파일을 따른다(고정하지 않음).
# hadolint ignore=DL3016
RUN if [ -f yarn.lock ]; then \
        yarn install --frozen-lockfile; \
    elif [ -f pnpm-lock.yaml ]; then \
        npm install -g pnpm && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then \
        npm ci; \
    else \
        npm install; \
    fi

COPY . .

# npm 자체의 --if-present 판정을 사용해 scripts.build만 정확히 실행한다.
RUN npm run build --if-present && rm -rf node_modules

# ---- Runtime stage ----
FROM node:{{NODE_VERSION}}-alpine AS runtime

LABEL org.opencontainers.image.title="{{APP_NAME}}" \
      org.opencontainers.image.description="Node.js Express application" \
      org.opencontainers.image.version="1.0"

# Security: run as non-root
RUN addgroup -g 1001 appgroup && \
    adduser -u 1001 -G appgroup -s /bin/sh -D appuser

# 배포 전 Trivy 검사에서 CRITICAL 이 나오면 실행이 차단된다 — 베이스 OS 패키지를
# 패치하고, 이미지에 번들된 npm(취약한 tar 동봉)은 앱이 node 로 직접 뜨므로 제거한다.
RUN apk upgrade --no-cache && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Install curl for health checks
# Alpine 저장소는 이전 패키지 버전을 지우므로 버전을 고정하면 빌드가 깨진다 — 같은 이미지의 최신 보안 패치를 쓴다.
# hadolint ignore=DL3018
RUN apk add --no-cache curl dumb-init

WORKDIR /app

# 앱이 작업 폴더에 파일(예: SQLite DB·업로드)을 만들 수 있게 한다 — 비root 로 실행하므로 필요하다.
RUN chown appuser:appgroup /app

# Copy the complete source/build output, then production-only dependencies.
# Plain Express apps commonly start index.js/server.js without a dist folder.
COPY --from=builder --chown=appuser:appgroup /app ./
COPY --from=deps --chown=appuser:appgroup /app/node_modules ./node_modules

USER appuser

EXPOSE {{PORT}}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "curl -f http://localhost:{{PORT}}{{HEALTH_CHECK_PATH}} || exit 1"]

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "{{START_SCRIPT}}"]
