# ReCoder Local Core 환경설정 예시
# 복사해서 .env 로 쓰거나, AWS 항목은 `python switch_aws.py` 로 자동 설정하세요.

# ── 분석 임계값 ──
RECODER_TRIGGER_THRESHOLD=0
RECODER_QUALITY_MIN=0
RECODER_QUALITY_WARN=0

# ── Bedrock 모델 ID ── (새 계정에서 해당 모델 액세스 활성화 필요)
# PRIMARY 는 설계 결정(/api/code/plan)과 코드 생성 품질을 좌우한다.
# Haiku 3(2024-03)으로 두면 "한국어 + 엄격한 JSON + 설계 판단" 조합에서
# 설계 결정이 깨지거나 빈약해진다 — 보드 이슈 「AI-DLC 설계 결정이 제대로
# 나오지 않음」의 주원인. PRIMARY/SECONDARY 는 Sonnet 급을 쓰고,
# FAST 만 Haiku 로 남긴다(트리거 판정 등 저부담 호출용).
BEDROCK_PRIMARY_MODEL_IDENTIFIER=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_SECONDARY_MODEL_IDENTIFIER=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_FAST_MODEL_IDENTIFIER=anthropic.claude-3-haiku-20240307-v1:0

# ── AWS 계정 설정 ── (계정 교체 시 여기만 바꾸면 됨. 또는 switch_aws.py 사용)
# 리전 3종은 항상 동일한 값으로! (모듈마다 읽는 변수명이 다름)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
BEDROCK_REGION=us-east-1
# 자격증명은 여기 넣지 말 것. aws configure / ~/.aws/credentials 로 관리하고 프로필만 지정:
# AWS_PROFILE=recoder

# Ops DOUBLE_CONFIRM actor credentials (use independent random secrets).
# Send one value in the X-Ops-Actor-Token header; the server derives the actor name.
RECODER_OPS_APPROVER_TOKENS={"alice":"replace-with-random-token-a","bob":"replace-with-random-token-b"}
