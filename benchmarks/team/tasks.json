 "tasks": [
  {
   "id": "T01-notes",
   "title": "메모 CRUD",
   "frontend": false,
   "prompt": "메모 REST API. Node.js Express 로 새 프로젝트를 만들어 줘. 데이터는 메모리에 저장해도 된다. 응답은 감싸지 않은 JSON 으로 보내고(예: {\"id\": 1, ...}), 오류는 {\"error\": \"이유\"} 로 보낸다. POST /api/notes {title, body} → 201 과 만든 메모 {id, title, body}. title 이 없거나 빈 문자열이면 400. GET /api/notes → 200 메모 배열(최근에 만든 것이 먼저). GET /api/notes/:id → 200 메모, 없으면 404. DELETE /api/notes/:id → 204, 지운 뒤 조회하면 404.",
   "criteria": [
    {
     "id": "AC-1",
     "text": "title 이 없거나 비어 있으면 400",
     "kind": "api",
     "check": "POST /api/notes {} → 400"
    },
    {
     "id": "AC-2",
     "text": "만든 메모를 id 로 다시 조회할 수 있다",
     "kind": "api",
     "check": "POST → 201, GET /api/notes/:id → 같은 title"
    },
    {
     "id": "AC-3",
     "text": "목록은 최근에 만든 메모가 먼저",
     "kind": "api",
     "check": "GET /api/notes 첫 항목 = 마지막으로 만든 메모"
    },
    {
     "id": "AC-4",
     "text": "지운 메모와 없는 id 는 404",
     "kind": "api",
     "check": "DELETE → 204, GET → 404"
    }
   ],
   "oracle": [
    {
     "criterion": "AC-1",
     "title": "제목 없음",
     "steps": [
      {
       "method": "POST",
