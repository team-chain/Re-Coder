       "body": {
        "body": "x"
       },
       "expect": {
        "status": [
         400
        ]
       }
      },
      {
       "method": "POST",
       "path": "/api/notes",
       "body": {
        "title": "",
        "body": "x"
       },
       "expect": {
        "status": [
         400
        ]
       }
      }
     ]
    },
    {
     "criterion": "AC-2",
     "title": "만들고 조회",
     "steps": [
      {
       "method": "POST",
       "path": "/api/notes",
       "body": {
        "title": "t{{rand}}",
        "body": "b"
       },
       "save": {
        "id": "id"
       },
       "expect": {
        "status": [
         201
        ],
        "json": [
         {
          "path": "title",
          "op": "equals",
          "value": "t{{rand}}"
         }
        ]
       }
      },
      {
