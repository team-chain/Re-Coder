# 운영자가 설정합니다. 일반 사용자는 VS Code의 Discord 연결 버튼만 사용합니다.
# Developer Portal > Applications > 기존 Re-Coder 앱 > Bot > Token
DISCORD_BOT_TOKEN=
# General Information > Application ID (비밀 값 아님)
DISCORD_CLIENT_ID=
# OAuth2 > Client Secret. VSIX나 Git에 포함하지 마세요.
DISCORD_CLIENT_SECRET=

# 같은 컴퓨터에서 먼저 검증할 때:
DISCORD_PUBLIC_URL=http://127.0.0.1:8765
BOT_HTTP_PORT=8765
# OAuth2 > Redirects에 아래 주소를 정확히 등록하세요:
# http://127.0.0.1:8765/api/v1/connect/callback
# 외부 운영 시 HTTPS 도메인으로 바꾸고 Redirect도 함께 변경합니다.
# reverse proxy는 /api/v1/connect/* HTTP와 /api/v1/connect/ws WebSocket을 전달합니다.

# 개발 서버의 slash commands 즉시 동기화 (선택)
DEV_GUILD_ID=
# 일반 채팅 개발 요청: Portal > Bot > Message Content Intent를 켠 뒤 1로 바꾸고 재시작.
# /recoder develop만 사용할 때는 특권 인텐트 없이 0을 유지할 수 있습니다.
DISCORD_MESSAGE_CONTENT=0

# 개발 요청을 처리할 봇 서버의 AI 설정 (AWS 인증은 표준 AWS 프로필/IAM 사용)
BEDROCK_REGION=ap-northeast-2
BEDROCK_PRIMARY_MODEL_IDENTIFIER=anthropic.claude-3-haiku-20240307-v1:0

# 기존 운영자 API/브리지. 일반 사용자에게 공유하지 않습니다.
BOT_REGISTRATION_KEY=
RECODER_BRIDGE_TOKEN=
RECODER_BRIDGE_REQUIRE_SECRET=1
GITHUB_WEBHOOK_SECRET=
RECODER_GATEWAY_URL=
RECODER_DEPLOY_TOKEN=
