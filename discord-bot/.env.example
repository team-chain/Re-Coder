# ReCoder Discord 봇 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 커밋되지 않습니다(.gitignore). 토큰을 다른 곳에 붙여넣지 마세요.

# ── 필수 ──
# Discord Developer Portal → 앱 → Bot → Reset Token
# 같은 화면의 Privileged Gateway Intents 에서 SERVER MEMBERS / MESSAGE CONTENT 를 켜야 연결됩니다.
DISCORD_BOT_TOKEN=

# ── 권장 ──
# Developer Portal → 앱 → General Information → Application ID (봇 초대 링크 생성용)
DISCORD_CLIENT_ID=
# VS Code 확장이 봇 상태·채널을 조회하는 HTTP 포트 (확장 설정 recoder.bridge.httpPort 와 같게)
BOT_HTTP_PORT=8765
# 비우면 이 PC(127.0.0.1)에서만 접근 가능. 다른 PC 에서 쓰려면 긴 임의 값을 넣고
# 확장 설정 recoder.bridge.registrationKey 에도 같은 값을 넣으세요.
BOT_REGISTRATION_KEY=
# VS Code 확장과 봇 사이 코드 스트리밍 브리지 토큰 (확장 설정 recoder.bridge.token 과 같게)
RECODER_BRIDGE_TOKEN=

# ── 선택 ──
# 설정하면 해당 서버에만 슬래시 명령을 즉시 동기화 (개발용)
DEV_GUILD_ID=

# ── 디스코드 배포(작업 패널 → S3 공개 배포)용 ──
# 게이트웨이 베이스 URL (운영자 게이트웨이 배포 후 Outputs.GatewayUrl)
RECODER_GATEWAY_URL=
# 배포용 학생 토큰 1개 (issue_tokens.py 로 발급) — 봇이 이 토큰으로 S3 업로드
RECODER_DEPLOY_TOKEN=
