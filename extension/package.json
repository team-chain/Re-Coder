{
  "name": "recoder",
  "displayName": "ReCoder — AI DevOps Agent",
  "description": "From Error to Operation: AI-powered DevOps agent for VSCode. Error analysis, code patching, Dockerfile generation, docker build/run, and ops response — all with approval-based safety.",
  "version": "1.1.13",
  "publisher": "recoder-team",
  "license": "MIT",
  "preview": true,
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/team-chain/Re-Coder.git"
  },
  "bugs": {
    "url": "https://github.com/team-chain/Re-Coder/issues"
  },
  "homepage": "https://github.com/team-chain/Re-Coder#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Debuggers"
  ],
  "keywords": [
    "ai",
    "devops",
    "docker",
    "bedrock",
    "agent",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0d11",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ReCoder는 로컬 Core 프로세스를 실행하고, 워크스페이스 파일을 수정하며, 클라우드로 배포합니다. 신뢰할 수 있는 워크스페이스에서만 동작합니다."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "로컬 파일 시스템과 Core 프로세스가 필요해 가상 워크스페이스에서는 동작하지 않습니다."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "recoder-activitybar",
          "title": "ReCoder",
          "icon": "media/recoder-icon.svg"
        }
      ]
    },
    "views": {
      "recoder-activitybar": [
        {
          "type": "webview",
          "id": "recoder.sidebarView",
          "name": "ReCoder",
          "visibility": "visible",
          "icon": "media/recoder-icon.svg"
        },
        {
          "type": "webview",
          "id": "recoder.workbenchView",
          "name": "Workbench",
          "visibility": "hidden"
        }
      ]
    },
    "commands": [
      {
        "command": "recoder.analyzeError",
        "title": "ReCoder: Analyze Error",
        "icon": "$(bug)"
      },
      {
        "command": "recoder.runWithRecoder",
        "title": "ReCoder: Run with ReCoder",
        "icon": "$(play)"
      },
      {
        "command": "recoder.generateDockerfile",
        "title": "ReCoder: Generate Dockerfile",
        "icon": "$(file-code)"
      },
      {
        "command": "recoder.generateGithubActions",
        "title": "ReCoder: Generate GitHub Actions Workflow",
        "icon": "$(github-action)"
      },
      {
        "command": "recoder.runDiagnostics",
        "title": "ReCoder: Run Diagnostics",
        "icon": "$(gear)"
      },
      {
        "command": "recoder.setupWizard",
        "title": "ReCoder: Setup Wizard (GitHub + AWS)",
        "icon": "$(rocket)"
      },
      {
        "command": "recoder.githubLogin",
        "title": "ReCoder: Connect GitHub",
        "icon": "$(github)"
      },
      {
        "command": "recoder.githubLogout",
        "title": "ReCoder: Disconnect GitHub",
        "icon": "$(sign-out)"
      },
      {
        "command": "recoder.awsConfigure",
        "title": "ReCoder: Configure AWS Credentials",
        "icon": "$(cloud)"
      },
      {
        "command": "recoder.awsClear",
        "title": "ReCoder: Clear AWS Credentials",
        "icon": "$(trash)"
      },
      {
        "command": "recoder.startCore",
        "title": "ReCoder: Start Core",
        "icon": "$(debug-start)"
      },
      {
        "command": "recoder.restartCore",
        "title": "ReCoder: Restart Core",
        "icon": "$(refresh)"
      },
      {
        "command": "recoder.stopCore",
        "title": "ReCoder: Stop Core",
        "icon": "$(stop)"
      },
      {
        "command": "recoder.openWorkbench",
        "title": "ReCoder: Open Workspace",
        "icon": "$(dashboard)"
      },
      {
        "command": "recoder.openReCoder",
        "title": "ReCoder: Open ReCoder",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "recoder.moveToRightSidebar",
        "title": "ReCoder: Move Sidebar View…",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "recoder.moveToLeftSidebar",
        "title": "ReCoder: Reset Sidebar Views",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "recoder.bridge.reconnect",
        "title": "ReCoder: Reconnect Discord Bridge",
        "icon": "$(refresh)"
      },
      {
        "command": "recoder.enroll",
        "title": "ReCoder: Connect to Gateway (Enroll)",
        "icon": "$(key)"
      },
      {
        "command": "recoder.ai.connect",
        "title": "ReCoder: Connect AI with API Key (Claude / ChatGPT)"
      },
      {
        "command": "recoder.selectProject",
        "title": "ReCoder: 배포할 프로젝트 폴더 변경",
        "icon": "$(folder)"
      },
      {
        "command": "recoder.generateInFolder",
        "title": "ReCoder: 이 폴더에 코드 생성",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "recoder.analyzeError",
          "group": "recoder@1",
          "when": "editorHasSelection"
        }
      ],
      "terminal/context": [
        {
          "command": "recoder.analyzeError",
          "group": "recoder@1"
        }
      ],
      "explorer/context": [
        {
          "command": "recoder.generateInFolder",
          "when": "explorerResourceIsFolder",
          "group": "recoder@1"
        }
      ],
      "view/title": [
        {
          "command": "recoder.openReCoder",
          "when": "view == recoder.sidebarView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "recoder.openWorkbench",
        "key": "ctrl+shift+r ctrl+w",
        "mac": "cmd+shift+r cmd+w",
        "when": "!terminalFocus"
      },
      {
        "command": "recoder.analyzeError",
        "key": "ctrl+shift+r ctrl+a",
        "mac": "cmd+shift+r cmd+a"
      }
    ],
    "configuration": {
      "title": "ReCoder",
      "properties": {
        "recoder.core.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Local Core when sidebar opens."
        },
        "recoder.workspace.hideSidebar": {
          "type": "boolean",
          "default": true,
          "description": "ReCoder 작업 화면을 열 때 VS Code 왼쪽 사이드바를 자동으로 숨깁니다."
        },
        "recoder.core.port": {
          "type": "number",
          "default": 17894,
          "description": "Base port for Local Core (fallback range: 17895–17910)."
        },
        "recoder.llm.provider": {
          "type": "string",
          "enum": [
            "bedrock",
            "gemini",
            "auto"
          ],
          "default": "auto",
          "description": "LLM provider preference. 'auto' uses Bedrock with Gemini fallback."
        },
        "recoder.llm.region": {
          "type": "string",
          "default": "us-east-1",
          "description": "AWS region for Bedrock API calls."
        },
        "recoder.context.maxLines": {
          "type": "number",
          "default": 200,
          "description": "Maximum terminal output lines to collect for context."
        },
        "recoder.polling.interval": {
          "type": "number",
          "default": 4000,
          "description": "Core status polling interval in milliseconds (3000–10000)."
        },
        "recoder.bridge.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Discord 봇 브리지 호스트 (recoder_bridge.py 가 바인딩한 주소)."
        },
        "recoder.bridge.port": {
          "type": "number",
          "default": 7780,
          "description": "Discord 봇 브리지 포트."
        },
        "recoder.bridge.token": {
          "type": "string",
          "default": "",
          "description": "Discord 봇 브리지 인증 토큰 (.env 의 RECODER_BRIDGE_TOKEN 과 동일해야 함)."
        },
        "recoder.bridge.studentId": {
          "type": "string",
          "default": "",
          "description": "Phase 2 per-user 라우팅 식별자. /recoder link 로 받은 student_id 를 넣으면 본인 디스코드 요청이 이 VSCode로만 전달됩니다. 비우면 전체 broadcast(단일 PC)."
        },
        "recoder.discord.clientId": {
          "type": "string",
          "default": "",
          "description": "Discord 봇의 Application(Client) ID. 설정하면 워크벤치 Discord 탭의 '봇 초대'가 봇 실행 없이도 동작합니다. Discord 개발자 포털 > Application > General 의 Application ID."
        },
        "recoder.gateway.url": {
          "type": "string",
          "default": "",
          "description": "운영자가 제공한 Bedrock 게이트웨이 베이스 URL(수업·팀 사용자용). 설정한 뒤 'ReCoder: Connect to Gateway (Enroll)' 로 등록 코드를 입력하면 AWS 키 없이 AI를 사용합니다. 비워 두면 본인 AWS 계정(BYO)으로 동작합니다."
        },
        "recoder.ai.anthropicModel": {
          "type": "string",
          "default": "",
          "description": "Claude API 키로 연결했을 때 쓸 모델 ID. 비우면 claude-sonnet-5."
        },
        "recoder.ai.openaiModel": {
          "type": "string",
          "default": "",
          "description": "OpenAI API 키로 연결했을 때 쓸 모델 ID. 비우면 gpt-5-mini."
        },
        "recoder.bridge.httpPort": {
          "type": "number",
          "default": 8765,
          "description": "Discord 봇 HTTP API 포트 (api_server.py — Workbench Discord 탭이 사용)."
        },
        "recoder.bridge.registrationKey": {
          "type": "string",
          "default": "",
          "description": "Discord 봇 HTTP API 인증 키 (.env 의 BOT_REGISTRATION_KEY 와 동일해야 함, 미설정 시 인증 생략)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run verify:package",
    "compile": "node scripts/prune-host-output.js && tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "build": "npm run compile && npm run build:webview",
    "build:webview": "cd webview-src && npx webpack --config webpack.config.js --mode production",
    "watch:webview": "cd webview-src && npx webpack --config webpack.config.js --mode development --watch",
    "package": "vsce package",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p webview-src/tsconfig.json --noEmit",
    "pretest": "npm run compile",
    "test": "tsc -p webview-src/tsconfig.test.json && node --test out/test/coreClient.smoke.js webview-tests/*.test.js",
    "verify:package": "node scripts/verify-package.js",
    "verify:release": "node scripts/verify-package.js --require-core",
    "smoke": "npm run compile && node --test out/test/coreClient.smoke.js",
    "test:webview": "npm run compile && npx tsc -p webview-src/tsconfig.test.json && node --test webview-tests/*.test.js",
    "package:all": "bash ../scripts/package-extension.sh",
    "package:nobinary": "bash ../scripts/package-extension.sh --no-binary",
    "test:e2e": "node harness/e2e-extension-flow.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": "^0.160.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^3.2.0",
    "autoprefixer": "^10.4.20",
    "css-loader": "^7.1.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "three": "0.160.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.9.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
